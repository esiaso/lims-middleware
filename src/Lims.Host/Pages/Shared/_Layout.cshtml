<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] - LIMS middleware</title>
<style>
  :root { --fg:#1b1f24; --muted:#5b6470; --bg:#fff; --line:#d8dde3; --accent:#1f5fae; }
  body { font: 15px/1.45 system-ui, "Segoe UI", sans-serif; color: var(--fg); background: var(--bg); margin: 0; }
  header { display:flex; gap:1rem; align-items:center; padding:.6rem 1rem; border-bottom:1px solid var(--line); flex-wrap: wrap; }
  header a { color: var(--accent); text-decoration: none; }
  main { padding: 1rem; max-width: 1200px; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; }
  .badge { display:inline-block; padding:.05rem .45rem; border-radius: .25rem; border:1px solid currentColor; font-size: .85em; }
  .Received { color:#555; } .Reviewed { color:#1f5fae; } .Approved, .Queued { color:#fff; background:#1f5fae; border-color:#1f5fae; }
  .Sent { color:#8a5a00; } .HMIS-confirmed { color:#fff; background:#2e7d32; border-color:#2e7d32; } .Failed { color:#fff; background:#c62828; border-color:#c62828; }
  .critical { color:#c62828; font-weight:700; }
  form.inline { display:inline; }
  .err { color:#c62828; }
  input, button, select { font: inherit; padding: .25rem .4rem; }
</style>
</head>
<body>
<header>
  <strong>LIMS middleware</strong>
  @if (User.Identity?.IsAuthenticated == true)
  {
    <a href="/">Health</a><a href="/Orders">Orders</a><a href="/Review">Review</a><a href="/Exceptions">Exceptions</a><a href="/Deliveries">Deliveries</a>
    <span style="margin-left:auto">@User.Identity.Name</span>
    <form method="post" action="/Logout" class="inline"><button type="submit">Sign out</button></form>
  }
</header>
<main>@RenderBody()</main>
</body>
</html>
